<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- La diaria de Magma: todos los días a las 8:00 manda el mail con lo que hay que hacer hoy.
       NO está instalado: se instala a mano, una sola vez, con OK de Juan:
         cp scripts/launchd/com.somosmagma.diaria.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.somosmagma.diaria.plist
       Probar ahora mismo:   launchctl start com.somosmagma.diaria
       Frenar:               launchctl unload ~/Library/LaunchAgents/com.somosmagma.diaria.plist
       Si la Mac estaba apagada o dormida a las 8, launchd lo corre al despertarse. -->
  <key>Label</key><string>com.somosmagma.diaria</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>scripts/diaria.mjs</string>
    <string>--mail</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/dronjuan/somos-magma-app</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/dronjuan/somos-magma-app/scripts/.diaria-stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/dronjuan/somos-magma-app/scripts/.diaria-stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
